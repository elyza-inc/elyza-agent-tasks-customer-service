# 環境変数の雛形。cp .env.template .env としてから値を記入してください。
# このファイルには実際のキーを書かないでください(.env は Git 管理外です)。

# 顧客役シミュレータと LLMジャッジに使用(必須)
OPENAI_API_KEY=

# 評価対象モデルの接続先ごとに必要なもの(使うものだけ設定)
# Anthropic のモデルを評価する場合
ANTHROPIC_API_KEY=

# Google Vertex AI のモデルを評価する場合(gcloud auth application-default login で取得した値)
GOOGLE_ACCESS_TOKEN=

# OpenAI 互換サーバ(vLLM / SGLang など)を評価する場合に、そのサーバのキーが必要なとき
LOCAL_API_KEY=
